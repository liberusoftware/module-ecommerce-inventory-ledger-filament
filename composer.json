{
    "name": "liberusoftware/ecommerce-inventory-ledger-filament",
    "description": "Filament administration for the append-only stock ledger: the movement trail, balances, holds and the integrity check that proves the two agree.",
    "type": "liberu-module",
    "license": "MIT",
    "version": "0.1.0",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/liberusoftware/module-ecommerce-inventory-ledger"
        }
    ],
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "filament/filament": "^5.0",
        "liberusoftware/module-manager": "^1.4",
        "liberusoftware/ecommerce-inventory-ledger": "^0.1"
    },
    "require-dev": {
        "liberusoftware/ecommerce-inventory-ledger": "^0.1",
        "liberusoftware/package-testbench": "^1.7",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Ecommerce\\InventoryLedger\\Filament\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Liberu\\Ecommerce\\InventoryLedger\\Filament\\Tests\\": "tests/"
        }
    },
    "extra": {
        "liberu": {
            "name": "ecommerce-inventory-ledger-filament"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
